{
  "name": "document_qa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --watch-path=./src/server ./src/server/main.js",
    "db:init": "node -e \"import('./src/server/db.js')\"",
    "strategy:stage": "node ./strategies/stage.js",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "docker:dev": "docker compose up",
    "docker:watch": "docker compose up --watch",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:stage": "docker compose exec app node strategies/stage.js",
    "docker:install": "docker compose exec -T app npm install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/autoload": "^6.5.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
